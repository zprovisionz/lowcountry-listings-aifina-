# ─────────────────────────────────────────────────────────────────────
# Lowcountry Listings AI — Example Environment Variables
# Copy to .env.local (frontend) and configure Supabase secrets (server).
# Do NOT commit real keys.
# ─────────────────────────────────────────────────────────────────────

# ── Frontend (Vite) ──────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
# Optional dev flag: unlock UI quota gates for debugging (still requires allowlisting in prod)
VITE_DEBUG_BYPASS_BILLING=false
n
# Optional: error tracking & product analytics (frontend)
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Supabase Edge Functions (server-side secrets) ────────────────────
# Set these in Supabase Dashboard → Project Settings → Edge Functions → Secrets
# or via CLI: supabase secrets set NAME=value
OPENAI_API_KEY=
# Primary listing copy (Claude). Falls back to OpenAI if unset.
ANTHROPIC_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: fal.ai virtual staging
FAL_KEY=

# Optional: enable server-side test mode bypass (Edge Functions)
# Requires DB allowlisting: profiles.is_test_user = true
ALLOW_TEST_MODE=false

# ── Stripe (server-side) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PLUS_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

### Lowcountry Listings AI — example env file
### Copy to `.env.local` for local dev (client-side Vite vars only)

# ── Client (Vite) ───────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_DEBUG_BYPASS_BILLING=false

### Optional: only needed if you run Supabase functions locally with `supabase functions serve`
### Put these in `./supabase/.env.local` (NOT in `.env.local`), or set them in Supabase Dashboard → Edge Functions → Secrets.

# ── Edge Functions secrets ──────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Edge Functions) ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PLUS_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# ── fal.ai (optional, virtual staging) ──────────────────────────────
FAL_KEY=

# ── Test mode (optional) ─────────────────────────────────────────────
ALLOW_TEST_MODE=false

